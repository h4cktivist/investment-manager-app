# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest
# Внешний порт БД (5432 часто занят локальным постгресом)
POSTGRES_PORT=5433

# --- Backend --------------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Подтягивать котировки/справочники при старте контейнера
SYNC_ON_STARTUP=true

# Автоматическое зачисление купонов, амортизаций и погашений в сделки
AUTO_POST_PAYMENTS=true
# На сколько дней назад догонять наступившие выплаты после простоя
AUTO_POST_LOOKBACK_DAYS=45
# Как часто проверять наступившие выплаты, минут
AUTO_POST_INTERVAL_MINUTES=60

# --- Котировки ------------------------------------------------------------
# moex    — MOEX ISS, бесплатно и без регистрации, задержка ~15 минут
# tinvest — T-Invest API (нужен бесплатный токен из ЛК Т-Инвестиций), реальный realtime
QUOTE_PROVIDER=moex
QUOTE_POLL_SECONDS=15
TINVEST_TOKEN=

# --- Метрики --------------------------------------------------------------
# Безрисковая ставка для Шарпа/Сортино (доля, не проценты). 0.16 = 16% годовых
RISK_FREE_RATE=0.16

# --- Макроэкономика на дашборде -------------------------------------------
# Ключевая ставка и инфляция — ЦБ РФ, доходность ОФЗ — MOEX ISS. Без ключей.
MACRO_ENABLED=true
# Как часто обновлять макроданные, минут
MACRO_CACHE_MINUTES=180
# Базовый адрес ЦБ РФ. Важно без www: www.cbr.ru закрыт DDoS-Guard
MACRO_CBR_BASE=https://cbr.ru
# Срок ОФЗ для основной карточки, лет
MACRO_OFZ_TENOR=10
