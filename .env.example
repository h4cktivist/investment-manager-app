# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest
# Внешний порт БД (5432 часто занят локальным постгресом)
POSTGRES_PORT=5433

# --- Backend --------------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Подтягивать котировки/справочники при старте контейнера
SYNC_ON_STARTUP=true

# --- Котировки ------------------------------------------------------------
# moex    — MOEX ISS, бесплатно и без регистрации, задержка ~15 минут
# tinvest — T-Invest API (нужен бесплатный токен из ЛК Т-Инвестиций), реальный realtime
QUOTE_PROVIDER=moex
QUOTE_POLL_SECONDS=15
TINVEST_TOKEN=

# --- Метрики --------------------------------------------------------------
# Безрисковая ставка для Шарпа/Сортино (доля, не проценты). 0.16 = 16% годовых
RISK_FREE_RATE=0.16
